<script>
    const navToggleClient = document.querySelector('.nav-toggle');
    const primaryNavClient = document.querySelector('.primary-nav');
    const bookBtnClient = document.querySelector('.btn-book');
    if (navToggleClient && primaryNavClient) {
        navToggleClient.addEventListener('click', () => {
            navToggleClient.classList.toggle('is-open');
            primaryNavClient.classList.toggle('is-open');
            if (bookBtnClient) {
                bookBtnClient.classList.toggle('is-open');
            }
        });
    }
</script>
