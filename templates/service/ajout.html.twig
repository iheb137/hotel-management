{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestion des services Service{% endblock %}

{% block body %}
    <div class="container my-5">
        <h3>{{ is_edit ? 'Modifier un service' : 'Ajouter un service' }}</h3>

        <div class="card">
            <div class="card-body">
                <div class="col-md-10">
                    {{ form_start(ServiceForm, {
                        'attr': {
                            'class': 'form'
                        },
                        'action': is_edit ? path('edit_service', {'id': serviceId}) : path('ajout_service'),
                        'method': 'post'
                    }) }}

                    <div class="form-group col-md-8">
                        {{ form_label(ServiceForm.nom, 'Nom de la chambre', {'label_attr': {'class': 'col-form-label'}}) }}
                        {{ form_widget(ServiceForm.nom, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Nom de la chambre'
                            }
                        }) }}
                    </div>




                    <div class="form-group col-md-8">
                        {{ form_label(ServiceForm.prix, 'Prix du Service', {'label_attr': {'class': 'col-form-label'}}) }}
                        {{ form_widget(ServiceForm.prix, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Prix de la chambre'
                            }
                        }) }}
                    </div>

                    <div class="form-group col-md-8">
                        {{ form_label(ServiceForm.description, 'Description', {'label_attr': {'class': 'col-form-label'}}) }}
                        {{ form_widget(ServiceForm.description, {
                            'attr': {
                                'class': 'form-control',
                                'placeholder': 'Description de la chambre'
                            }
                        }) }}
                    </div>

                    <div class="form-group col-md-8">
                        {{ form_label(ServiceForm.thumbnail, 'Charger Thumbnail') }}
                        {{ form_widget(ServiceForm.thumbnail, {
                            'attr': {
                                'class': 'form-control-file',
                                'accept': 'image/*'
                            }
                        }) }}
                    </div>

                    <div class="col-md-6">
                        <button type="submit" class="btn btn-primary mt-3">
                            {{ is_edit ? 'Modifier' : 'Ajouter' }}
                        </button>
                    </div>

                    {{ form_end(ServiceForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
