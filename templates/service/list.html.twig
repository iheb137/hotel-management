{% extends 'baseAdmin.html.twig' %}



{% block body %}

    <div class="container my-5">
        <h3>Liste des évenements</h3>
        <a href="{{ path('app_service_ajout') }}" class="btn btn-primary mb-3">
            <i class="fas fa-plus-circle"></i> Ajouter un évenement
        </a>
        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-responsive-md">
                    <thead>
                    <tr>
                        <th>Thumbnail</th>

                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Description</th>
                        <th>Supprimer</th>
                        <th>Modifier</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for service in services %}
                        <tr>
                            <td>
                                {% if service.thumbnail %}
                                    <img src="{{ asset(service.thumbnail) }}" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: auto;">
                                {% else %}
                                    <img src="{{ asset('assets/images/default.png') }}" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: auto;">
                                {% endif %}
                            </td>
                            <td>{{ service.nom }}</td>
                            <td>{{ service.prix }}</td>
                            <td>{{ service.description }}</td>
                            <td>
                                <a href="{{ path('delete_service', {'id': service.id}) }}" class="btn btn-danger"
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette service ?');">
                                    <i class="fa fa-trash-alt"></i>
                                </a>
                            </td>
                            <td>
                                <a href="{{ path('edit_service', {'id': service.id}) }}" class="btn btn-warning">
                                    <i class="fa fa-wrench"></i>
                                </a>
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucun évenement trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

