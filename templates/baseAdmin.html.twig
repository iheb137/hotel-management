<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>IH-AR | Admin</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.png') }}">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.3.1/css/bootstrap.min.css">

    <!-- Core CSS -->
    <link rel="stylesheet" href="{{ asset('assets/css/default.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/plugin.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/icons.css') }}">

    <!-- Font Awesome (UNE SEULE FOIS – CORRECT) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    {% block stylesheets %}{% endblock %}
</head>

<body>

<div id="preloader">
    <div id="status"></div>
</div>

<div id="container-wrapper">
    <div id="dashboard">

        <!-- Top Nav -->
        <div class="dashboard-sticky-nav">
            <div class="content-left pull-left">
                <a href="{{ path('app_dashboard') }}">
                    <img src="{{ asset('uploads/images/default.png') }}" alt="logo">
                </a>
            </div>

            <div class="content-right pull-right">
                {% if app.user %}
                    <a href="{{ path('account_edit', {'id': app.user.id}) }}">
                        <div class="profile-sec">
                            <div class="dash-image">
                                <img src="{{ app.user.image ? asset(app.user.image) : asset('assets/images/default-avatar.png') }}" alt="">
                            </div>
                            <div class="dash-content">
                                <h4>{{ app.user.nom ?? app.user.email }}</h4>
                                <span>Admin</span>
                            </div>
                        </div>
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Sidebar -->
        <div class="dashboard-nav">
            <div class="dashboard-nav-inner">
                <ul>

                    <li class="{% if selected == 'dashboard' %}active{% endif %}">
                        <a href="{{ path('app_dashboard') }}">
                            <i class="sl sl-icon-settings"></i> Tableau de bord
                        </a>
                    </li>

                    <li class="{% if selected == 'chambre' %}active{% endif %}">
                        <a href="{{ path('all_room') }}">
                            <i class="sl sl-icon-layers"></i> Rooms
                        </a>
                        <ul>
                            <li><a href="{{ path('all_room') }}">Liste des Rooms</a></li>
                            <li><a href="{{ path('ajout_room') }}">Ajouter une Room</a></li>
                        </ul>
                    </li>

                    <li class="{% if selected == 'evenement' %}active{% endif %}">
                        <a href="{{ path('all_event') }}">
                            <i class="sl sl-icon-layers"></i> Events
                        </a>
                        <ul>
                            <li><a href="{{ path('all_event') }}">Liste des Events</a></li>
                            <li><a href="{{ path('ajout_event') }}">Ajouter un Event</a></li>
                        </ul>
                    </li>

                    <!-- 🔥 RÉSERVATIONS (CORRIGÉ) -->
                    <li class="{% if selected == 'reservations' %}active{% endif %}">
                        <a href="{{ path('admin_reservations') }}">
                            <i class="sl sl-icon-calendar"></i> Reservations
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_service_list') }}">
                            <i class="sl sl-icon-layers"></i> Services
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('admin_client_list') }}">
                            <i class="sl sl-icon-user"></i> Users
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_home') }}">
                            <i class="sl sl-icon-screen-desktop"></i> User Interface
                        </a>
                    </li>

                    <li>
                        <a href="{{ path('app_logout') }}">
                            <i class="sl sl-icon-power"></i> Déconnexion
                        </a>
                    </li>

                </ul>
            </div>
        </div>

        <!-- Content -->
        <div class="dashboard-content">
            {% block body %}{% endblock %}
        </div>

    </div>
</div>

<!-- JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.3.1/js/bootstrap.min.js"></script>
<script src="{{ asset('assets/js/plugin.js') }}"></script>
<script src="{{ asset('assets/js/main.js') }}"></script>

<!-- CanvasJS (CORRECT) -->
<script src="https://canvasjs.com/assets/script/canvasjs.min.js"></script>

<!-- Charts -->
<script src="{{ asset('assets/js/chart.js') }}"></script>
<script src="{{ asset('assets/js/dashboard.js') }}"></script>

{% block javascripts %}{% endblock %}
</body>
</html>

</html>
