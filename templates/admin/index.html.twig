{% extends 'base.html.twig' %}

{% block title %}Hello AdminController!{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>Hello {{ controller_name }}! ✅</h1>

        This friendly message is coming from:
        <ul>
            <li>Your controller at <code>C:/xampp/htdocs/true_project/src/Controller/AdminController.php</code></li>
            <li>Your template at <code>C:/xampp/htdocs/true_project/templates/admin/index.html.twig</code></li>
        </ul>
    </div>
    <h2>Liste des réservations</h2>

    <table class="table table-bordered">
        <thead>
        <tr>
            <th>ID</th>
            <th>Client</th>
            <th>Chambre</th>
            <th>Dates</th>
            <th>Prix</th>
            <th>Statut</th>
        </tr>
        </thead>
        <tbody>
        {% for r in reservations %}
            <tr>
                <td>{{ r.id }}</td>
                <td>{{ r.user.email }}</td>
                <td>{{ r.room.name }}</td>
                <td>
                    {{ r.startDate|date('Y-m-d') }}
                    →
                    {{ r.endDate|date('Y-m-d') }}
                </td>
                <td>{{ r.prix }} DT</td>
                <td>{{ r.statut }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucune réservation</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
