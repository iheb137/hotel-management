{% extends 'admin/dashboard.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <h2 class="mb-4">Liste des réservations</h2>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="card">
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Date création</th>
                        <th>Action</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>{{ reservation.id }}</td>

                            <td>{{ reservation.user.email }}</td>

                            <td>{{ reservation.room.nom ?? 'N/A' }}</td>

                            <td>
                            <span class="badge
                                {% if reservation.statut == 'accepted' %}badge-success
                                {% elseif reservation.statut == 'refused' %}badge-danger
                                {% else %}badge-secondary{% endif %}">
                                {{ reservation.statut }}
                            </span>
                            </td>

                            <td>{{ reservation.createdAt|date('Y-m-d H:i') }}</td>

                            <td>
                                <form method="post" action="{{ path('admin_reservation_status', {id: reservation.id}) }}">
                                    <select name="status" class="form-control form-control-sm mb-2">
                                        <option value="pending" {{ reservation.statut == 'pending' ? 'selected' }}>Pending</option>
                                        <option value="accepted" {{ reservation.statut == 'accepted' ? 'selected' }}>Accepted</option>
                                        <option value="refused" {{ reservation.statut == 'refused' ? 'selected' }}>Refused</option>
                                    </select>

                                    <button class="btn btn-sm btn-primary w-100">
                                        Update
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucune réservation</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
