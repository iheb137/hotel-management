{% extends 'baseAdmin.html.twig' %}
{% block body %}
            <div class="row">

                <!-- Item -->
                <div class="col-lg-3 col-md-6 col-xs-6">
                    <div class="dashboard-stat color-1">
                        <div class="dashboard-stat-content"><h4>{{ roomnbr }}</h4> <span>Room Types</span></div>
                        <div class="dashboard-stat-icon"><i class="im im-icon-Map2"></i></div>
                        <div class="dashboard-stat-item"><p style="font-weight: bold">Events Planned: {{ eventnbr}} </p></div>
                    </div>
                </div>

                <!-- Item -->
                <div class="col-lg-3 col-md-6 col-xs-6">
                    <div class="dashboard-stat color-2">
                        <div class="dashboard-stat-content"><h4>${{ revenueThisMonth }}</h4> <span>Revenue this Month</span></div>
                        <div class="dashboard-stat-icon"><i class="im im-icon-Line-Chart"></i></div>
                        <div class="dashboard-stat-item"><p style="font-weight: bold">All Time Revenue: ${{ revenue }}</p></div>
                    </div>
                </div>


                <!-- Item -->
                <div class="col-lg-3 col-md-6 col-xs-6">
                    <div class="dashboard-stat color-3">
                        <div class="dashboard-stat-content"><h4>{{ ClientNbr }}</h4> <span>Clients Number</span></div>
                        <div class="dashboard-stat-icon"><i class="im im-icon-Add-UserStar"></i></div>
                        <div class="dashboard-stat-item"><p>Admin Number: {{ AdminNbr}}</p></div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6 col-xs-6">
                    <div class="dashboard-stat color-4">
                        <div class="dashboard-stat-content"><h4>{{ reviewsNbr }}</h4> <span>Total Reviews</span></div>
                        <div class="dashboard-stat-icon"><i class="im im-icon-Heart"></i></div>
                        <div class="dashboard-stat-item"><p style="font-weight: bold">Event Comments: {{ commentsNbr}}</p></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 col-md-12 col-xs-12 traffic">
                    <div class="dashboard-list-box">
                        <h4 class="gray">Most Popular Rooms</h4>
                        <div class="table-box">
                            <table class="basic-table">
                                <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Room ID</th>
                                    <th>Room Name</th>
                                    <th>Reservation Number</th>
                                    <th>Total Revenue</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for stat in RoomStats|slice(0, 5) %}
                                    <tr>
                                        <td><img src="{{ stat.Thumbnail }}" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: auto;" /></td>
                                        <td class="t-id">{{ stat.roomId }}</td>
                                        <td>{{ stat.name }}</td>
                                        <td>{{ stat.reservationCount }}</td>
                                        <td>${{ stat.totalRevenue }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-7 col-md-12 col-xs-12 traffic">
                    <div class="dashboard-list-box with-icons margin-top-20">
                        <h4 class="gray">Popular Services</h4>
                        <div class="table-box">
                            <table class="basic-table">
                                <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Service ID</th>
                                    <th>Service Name</th>
                                    <th>Service Orders</th>
                                    <th>Total Revenue</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for stat in serviceStat|slice(0, 3) %}
                                    <tr>
                                        <td><img src="{{ stat.thumbnail }}" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: auto;" /></td>
                                        <td class="t-id">{{ stat.serviceId }}</td>
                                        <td>{{ stat.nom }}</td>

                                        <td>{{ stat.reservationCount }}</td>

                                        <td>${{ stat.totalRevenue }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-12 col-xs-12 traffic">
                    <div class="dashboard-list-box margin-top-20 user-list">
                        <h4 class="gray">Popular Events</h4>
                        <table class="basic-table">
                            <thead>
                            <tr>
                                <th>Image</th>

                                <th>Room Name</th>

                                <th>Total Revenue</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for stat in eventStat|slice(0, 3) %}
                                <tr>
                                    <td><img src="{{ stat.thumbnail }}" alt="Thumbnail" class="img-thumbnail" style="width: 100px; height: auto;" /></td>

                                    <td>{{ stat.name }}</td>



                                    <td>${{ stat.totalRevenue }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

{% endblock %}

