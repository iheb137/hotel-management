{% extends 'baseAdmin.html.twig' %}

{% block body %}

    <!-- ================== ACTIONS RAPIDES ================== -->
    <div class="row margin-bottom-20">
        <div class="col-lg-12">
            <div class="dashboard-list-box">
                <h4 class="gray">Actions Rapides</h4>

                <div class="dashboard-list-box-static">
                    <div class="row">

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('ajout_room') }}" class="quick-action-btn">
                                <i class="fa fa-plus-circle"></i>
                                <span>Ajouter une Room</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('ajout_event') }}" class="quick-action-btn">
                                <i class="fa fa-plus-circle"></i>
                                <span>Ajouter un Event</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('all_room') }}" class="quick-action-btn">
                                <i class="fa fa-list"></i>
                                <span>Gérer les Rooms</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <!-- ✅ LIEN CORRIGÉ -->
                            <a href="{{ path('admin_reservations') }}" class="quick-action-btn">
                                <i class="fa fa-calendar-check"></i>
                                <span>Gérer les Réservations</span>
                            </a>
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('admin_client_list') }}" class="quick-action-btn">
                                <i class="fa fa-users"></i>
                                <span>Gérer les Utilisateurs</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('all_event') }}" class="quick-action-btn">
                                <i class="fa fa-calendar"></i>
                                <span>Gérer les Events</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('app_service_list') }}" class="quick-action-btn">
                                <i class="fa fa-cog"></i>
                                <span>Gérer les Services</span>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 margin-bottom-15">
                            <a href="{{ path('app_home') }}" class="quick-action-btn">
                                <i class="fa fa-globe"></i>
                                <span>Voir le Site</span>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================== STATISTIQUES ================== -->
    <div class="row">

        <div class="col-lg-3 col-md-6 col-xs-6">
            <div class="dashboard-stat color-1">
                <div class="dashboard-stat-content">
                    <h4>{{ roomnbr }}</h4>
                    <span>Room Types</span>
                </div>
                <div class="dashboard-stat-icon">
                    <i class="im im-icon-Map2"></i>
                </div>
                <div class="dashboard-stat-item">
                    <p><strong>Events Planned:</strong> {{ eventnbr }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-xs-6">
            <div class="dashboard-stat color-2">
                <div class="dashboard-stat-content">
                    <h4>${{ revenueThisMonth }}</h4>
                    <span>Revenue this Month</span>
                </div>
                <div class="dashboard-stat-icon">
                    <i class="im im-icon-Line-Chart"></i>
                </div>
                <div class="dashboard-stat-item">
                    <p><strong>Total:</strong> ${{ revenue }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-xs-6">
            <div class="dashboard-stat color-3">
                <div class="dashboard-stat-content">
                    <h4>{{ ClientNbr }}</h4>
                    <span>Clients</span>
                </div>
                <div class="dashboard-stat-icon">
                    <i class="im im-icon-Add-UserStar"></i>
                </div>
                <div class="dashboard-stat-item">
                    <p><strong>Admins:</strong> {{ AdminNbr }}</p>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 col-xs-6">
            <div class="dashboard-stat color-4">
                <div class="dashboard-stat-content">
                    <h4>{{ reviewsNbr }}</h4>
                    <span>Total Reviews</span>
                </div>
                <div class="dashboard-stat-icon">
                    <i class="im im-icon-Heart"></i>
                </div>
                <div class="dashboard-stat-item">
                    <p><strong>Event Comments:</strong> {{ commentsNbr }}</p>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
