{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h2>Détail de la réservation</h2>

        <ul class="list-group mt-4">
            <li class="list-group-item">
                <strong>Chambre :</strong> {{ reservation.room.nom }}
            </li>
            <li class="list-group-item">
                <strong>Date début :</strong> {{ reservation.startDate|date('Y-m-d') }}
            </li>
            <li class="list-group-item">
                <strong>Date fin :</strong> {{ reservation.endDate|date('Y-m-d') }}
            </li>
            <li class="list-group-item">
                <strong>Prix :</strong> {{ reservation.prix }} €
            </li>
            <li class="list-group-item">
                <strong>Statut :</strong>
                <span class="badge
                {% if reservation.statut == 'accepted' %}bg-success
                {% elseif reservation.statut == 'refused' %}bg-danger
                {% else %}bg-warning{% endif %}
            ">
                {{ reservation.statut|capitalize }}
            </span>
            </li>
        </ul>

        <a href="{{ path('user_reservations') }}" class="btn btn-secondary mt-3">
            Retour
        </a>
    </div>
{% endblock %}
