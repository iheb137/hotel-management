{% extends 'baseClient.html.twig' %}

{% block title %}New Reservation{% endblock %}

{% block body %}
    <section class="breadcrumb-outer">
        <div class="container">
            <div class="breadcrumb-content">
                <h2>{{ room.name }}</h2>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main style="max-width: 1200px; margin: 20px auto; display: flex; gap: 20px;">

        <!-- Room Details Section -->
        <div style="flex: 2; background-color: #fff; border-radius: 5px; padding: 20px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
            <div style="margin-bottom: 20px; position: relative; padding-top: 56.25%; overflow: hidden; border-radius: 8px;">
                {% if room.Thumbnail %}
                    <img src="{{ asset(room.Thumbnail) }}" alt="Room Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                {% else %}
                    <img src="{{ asset('assets/images/default-room.jpg') }}" alt="Default Room Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                {% endif %}
            </div>
            <h3 style="margin: 0 0 10px; font-size: 24px; font-weight: bold;">{{ room.name }}</h3>
            <p style="color: #777; margin-bottom: 15px;">{{ room.description }}</p>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px; color: #555;">
                <li><i class="fa fa-tag"></i> ${{ room.prix }} / Night</li>
                <li><i class="fa fa-bed"></i> {{ room.bedNbr }} Bedrooms</li>
            </ul>
        </div>

        <!-- Booking Sidebar -->
        <aside style="flex: 1; background-color: #f8f9fa; padding: 20px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
            <h3 style="margin: 0 0 20px; font-size: 24px; color: #ff5722;">${{ room.prix }}/Night</h3>

            {{ form_start(form) }}

            <div style="margin-bottom: 15px;">
                {{ form_row(form.StartDate, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;', 'id': 'start-date'}}) }}
            </div>

            <div style="margin-bottom: 15px;">
                {{ form_row(form.EndDate, {'attr': {'style': 'width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;', 'id': 'end-date'}}) }}
            </div>

            <!-- Total Price Display -->
            <div id="total-price" style="font-weight: bold; font-size: 20px; color: #ff5722; margin-top: 20px;">
                Total Price: $0
            </div>

            <button type="submit" style="background-color: #ff5722; color: white; padding: 10px; width: 100%; border: none; border-radius: 5px; font-size: 16px; margin-top: 20px;">
                BOOK NOW
            </button>






            {{ form_end(form) }}
        </aside>
    </main>

    <section style="padding: 20px;  border-radius: 8px;margin: 50px">
        {{ form_start(form2, {'attr': {'style': 'display: flex; align-items: center; gap: 15px;'}}) }}


        <div style="display: flex; align-items: center;">
            <div style="
            width: 40px;
            height: 40px;
            border-radius: 50%;

            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-weight: bold;
            font-size: 18px;">
                <img
                        src="{{ asset(app.user.image) }}"
                        alt="User Image"
                        style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%; margin-right: 20px;"
                />
            </div>
        </div>


        <div style="flex-grow: 1;">
            {{ form_widget(form2.texte, {'attr': {'class': 'form-control', 'placeholder': 'Post a Review', 'style': '  border: none; outline: none; border-bottom: 1px solid gray;'}}) }}
        </div>


        <div>
            <button type="submit" class="btn"
                    style="
                background-color: #FF4500;
                color: white;
                border: none;
                border-radius: 20px;
                padding: 8px 15px;
                font-weight: bold;">
                Post
            </button>
        </div>

        {{ form_end(form2) }}
    </section>
    <section style="padding: 50px">
        <h3>{{ nbrComments }} Reviews</h3><br><br>
        <ul class="list-unstyled">
            {% for comment in comments %}
                <li style="display: flex; align-items: center; margin-bottom: 20px;">
                    <img
                            src="{{ asset(comment.user.image) }}"
                            alt="User Image"
                            style="width: 150px; height: 150px; object-fit: cover; border-radius: 50%; margin-right: 20px;"
                    />
                    <div>
                        <strong>{{ comment.user.nom }}:</strong><br>
                        <span>{{ comment.date|date('F j, Y \\a\\t g:i a') }}</span><br>
                        <p>{{ comment.texte }}</p>

                        {% if app.user and comment.user.id == app.user.id %}
                            <form method="post" action="{{ path('app_comment_delete', { id: comment.id }) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        {% endif %}
                    </div>
                </li>
            {% else %}
                <li class="text-center">pas de commentaire</li>
            {% endfor %}

        </ul>

    </section>



    <script>
        function calculateTotalPrice() {
            const startDate = new Date(document.getElementById('start-date').value);
            const endDate = new Date(document.getElementById('end-date').value);
            const roomPricePerNight = {{ room.prix }};

            if (startDate && endDate && endDate > startDate) {
                const timeDifference = endDate - startDate;
                const days = Math.ceil(timeDifference / (1000 * 60 * 60 * 24));
                const totalPrice = days * roomPricePerNight;

                document.getElementById('total-price').innerText = `Total Price: $${totalPrice}`;
            } else {
                document.getElementById('total-price').innerText = 'Total Price: $0';
            }
        }

        document.getElementById('start-date').addEventListener('change', calculateTotalPrice);
        document.getElementById('end-date').addEventListener('change', calculateTotalPrice);
    </script>


{% endblock %}

