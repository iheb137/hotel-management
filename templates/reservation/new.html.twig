{% extends 'base.html.twig' %}

{% block title %}Réserver la chambre{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row align-items-center">

            {# IMAGE DE LA CHAMBRE #}
            <div class="col-lg-6 mb-4">
                <div class="card border-0 shadow-sm">
                    {% if room.image %}
                        <img
                                src="{{ asset('assets/images/room-list/' ~ room.image) }}"
                                class="img-fluid rounded"
                                alt="Chambre {{ room.numero ?? room.id }}"
                                style="height: 380px; object-fit: cover;"
                        >
                    {% else %}
                        <img
                                src="{{ asset('assets/images/room-list/grid1.jpg') }}"
                                class="img-fluid rounded"
                                alt="Aucune image"
                                style="height: 380px; object-fit: cover;"
                        >
                    {% endif %}
                </div>
            </div>

            {# FORMULAIRE #}
            <div class="col-lg-6">
                <h2 class="mb-4 text-uppercase fw-bold">
                    Réserver la chambre {{ room.numero ?? room.id }}
                </h2>

                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_row(form.startDate) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.endDate) }}
                </div>

                <button class="btn btn-primary btn-lg w-100">
                    Confirmer la réservation
                </button>
                {{ form_end(form) }}
            </div>

        </div>
    </div>
{% endblock %}
