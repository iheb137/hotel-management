{% set base_template = app.user ? 'baseClient.html.twig' : 'baseUser.html.twig' %}
{% extends base_template %}

{% block title %}Home{% endblock %}

{% block body %}

    <!-- banner starts -->
    <section class="banner">
        <div class="slider">
            <div class="swiper-container">
                <div class="swiper-wrapper">

                    <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider4.jpg') }})">
                        <div class="swiper-content">
                            <div class="slider-logo">
                                <img src="{{ asset('assets/images/icons/bed-logo.png') }}" alt="Image" />
                            </div>
                            <h3>Room Availability Checker & Booking</h3>
                            <h1>Book Early <span>Save</span> More</h1>
                            <a href="{{ path('app_room') }}" class="slider-btn btn-or mar-right-10">Explore Our Rooms</a>
                        </div>
                    </div>

                    <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider2.jpg') }})">
                        <div class="swiper-content">
                            <h3>The lap of Luxury</h3>
                            <h1>Quality <span>Holiday</span> With Us</h1>
                        </div>
                    </div>

                    <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider3.jpg') }})">
                        <div class="swiper-content">
                            <h3>As We Like to Keep It That Way</h3>
                            <h1>A <span>Five Star</span> Hotel</h1>
                        </div>
                    </div>

                </div>
                <div class="swiper-pagination"></div>
            </div>
            <div class="overlay"></div>
        </div>
    </section>

    <!-- Rooms starts -->
    <section class="rooms">
        <div class="list-content" style="padding: 10px;">
            <h2 style="text-align: center">Explore <span>Rooms</span></h2>
            <p style="text-align: center; font-weight: bold">
                Explore a range of luxurious rooms, each offering comfort, elegance, and modern amenities.
            </p>

            <div class="row" style="gap:20px;margin:0;">
                {% for room in rooms|slice(0,3) %}
                    <div class="col-lg-4 col-md-6">
                        <div class="room-item" style="border:1px solid #ddd;border-radius:8px;background:#fff;display:flex;flex-direction:column;margin:15px">

                            <div class="room-image" style="height:220px;overflow:hidden;">
                                {% if room.Thumbnail %}
                                    <img src="{{ asset(room.Thumbnail) }}" style="width:100%;height:100%;object-fit:cover;">
                                {% else %}
                                    <img src="{{ asset('images/default-room.jpg') }}" style="width:100%;height:100%;object-fit:cover;">
                                {% endif %}
                            </div>

                            <div class="room-content" style="padding:15px;flex-grow:1">
                                <h4>{{ room.name }}</h4>
                                <p><i class="fa fa-tag"></i> ${{ room.prix }} / Night</p>
                                <p><i class="fa fa-bed"></i> {{ room.bedNbr }} Bedrooms</p>
                                <p>{{ room.description }}</p>

                                <!-- ✅ ROUTE CORRIGÉE ICI -->
                                <a href="{{ path('reservation_new', {'id': room.id}) }}"
                                   class="btn"
                                   style="background:#ff5722;color:#fff;padding:8px 12px;border-radius:5px;">
                                    RESERVE
                                </a>
                            </div>

                        </div>
                    </div>
                {% else %}
                    <p class="text-center">No rooms available.</p>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Services -->
    <section class="services service-style-2">
        <div class="container-fluid">
            <h2 class="text-center">Explore <span>Services</span></h2>
            <div class="row">
                {% for service in services %}
                    <div class="col-lg-3 col-md-6">
                        <div class="service-item" style="height:300px;position:relative">
                            <img src="{{ asset(service.Thumbnail) }}" style="width:100%;height:100%;object-fit:cover;">
                            <div style="position:absolute;bottom:0;background:rgba(0,0,0,.6);color:#fff;padding:15px;width:100%">
                                <h4>{{ service.nom }}</h4>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Events -->
    <section class="events">
        <div class="container">
            <h2 class="text-center">Upcoming <span>Events</span></h2>

            <div class="row">
                {% for event in events|slice(0,3) %}
                    <div class="col-lg-4">
                        <div class="room-item" style="margin:15px;border:1px solid #ddd;border-radius:8px;">
                            <img src="{{ asset(event.Thumbnail) }}" style="width:100%;height:250px;object-fit:cover;">
                            <div style="padding:15px">
                                <h4>{{ event.name }}</h4>
                                <p>{{ event.description }}</p>
                                <p><i class="fa fa-calendar"></i> {{ event.date|date('Y-m-d') }}</p>
                                <a href="{{ path('app_detail_event', {'id': event.id}) }}"
                                   class="btn"
                                   style="background:#ff5722;color:#fff;padding:8px 12px;border-radius:5px;">
                                    Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">No events available.</p>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
