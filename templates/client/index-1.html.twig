{% set base_template = app.user ? 'baseClient.html.twig' : 'baseUser.html.twig' %}
{% extends base_template %}

{% block title %}Home{% endblock %}

{% block body %}

    <title>Home</title>

<!-- banner starts -->
<section class="banner">
    <div class="slider">
        <div class="swiper-container">
            <div class="swiper-wrapper">
                <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider4.jpg') }})">
                    <div class="swiper-content">
                        <div class="slider-logo">
                            <img src="{{ asset("assets/images/icons/bed-logo.png") }}" alt="Image" />
                        </div>
                        <h3 data-animation="animated fadeInUp">Room Availability Checker & Booking</h3>
                        <h1 data-animation="animated fadeInUp">Book Early <span>Save</span>More</h1>
                        <a href="{{ path('app_room') }}" data-animation="animated fadeInUp" class="slider-btn btn-or mar-right-10">Explore Our Rooms</a>
                    </div>
                </div>
                <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider2.jpg') }})">
                    <div class="swiper-content">
                        <div class="slider-logo">
                            <img src="images/icons/bed-logo.png" alt="Image" />
                        </div>
                        <h3 data-animation="animated fadeInUp">The lap of Luxury</h3>
                        <h1 data-animation="animated fadeInUp">Quality <span>Holiday</span> With Us</h1>
                        <a href="#" data-animation="animated fadeInUp" class="slider-btn btn-or">Book A Room Now</a>
                    </div>
                </div>
                <div class="swiper-slide" style="background-image: url({{ asset('assets/images/slider/slider3.jpg') }})">
                    <div class="swiper-content">
                        <div class="slider-logo">
                            <img src="images/icons/bed-logo.png" alt="Image" />
                        </div>
                        <h3 data-animation="animated fadeInUp">As We Like to Keep It That Way</h3>
                        <h1 data-animation="animated fadeInUp">A <span>Five Star</span> Hotel</h1>
                        <a href="#" data-animation="animated fadeInUp" class="slider-btn btn-or mar-right-10">Explore Our Rooms</a>
                        <a href="#" data-animation="animated fadeInUp" class="slider-btn btn-wt">Book A Room Now</a>
                    </div>
                </div>
            </div>
            <!-- Add Pagination -->
            <div class="swiper-pagination"></div>
        </div>
        <div class="overlay"></div>
    </div>



<!-- about us starts -->
<section class="about-style-2">
    <div class="container">
        <div class="about-inner">
            <div class="about-heading mar-bottom-40">
                <h2 class="title">Comfort are <span>perfectly</span> combined here</h2>
                <div class="description">
                    <p>
                        This charming private 19th century mansion, which originally belonged to the family, has been completely renovated with care &amp; passion while
                        respecting the spirit of place.
                    </p>
                    <p>Hotux Hotel surrounded herself by a team of French artisans to create a sophisticated place in a refined.</p>
                </div>
            </div>
            <div class="about-img-box row">
                <div class="col-lg-4 col-md-6">
                    <img src="images/about1.jpg" alt="" />
                </div>
                <div class="col-lg-4 col-md-6">
                    <img src="images/about3.jpg" alt="" />
                </div>
                <div class="col-lg-4 col-md-12">
                    <img src="images/about4.jpg" alt="" />
                </div>
            </div>
        </div>
    </div>
</section>
<!-- about us Ends -->

<!-- Rooms starts -->
<section class="rooms">
    <div class="list-content" style="padding: 10px;">
        <div class="row" style="gap: 20px; margin: 0;">
            <h2 style="text-align: center">Explore <span>Rooms</span></h2>
<p style="text-align: center; font-weight: bold">Explore a range of luxurious rooms, each offering comfort, elegance, and modern amenities for an unforgettable stay.</p>
            {% for room in rooms|slice(0, 3) %}
                <div class="col-lg-4 col-md-6 mar-bottom-30" style="padding: 0">
                    <div class="room-item" style="border: 1px solid #ddd; border-radius: 8px; background-color: #fff; text-align: center; height: auto; display: flex; flex-direction: column; justify-content: space-between; margin: 15px 15px 20px;">
                        <div class="room-image" style="margin-bottom: 10px; position: relative; padding-top: 56.25%; overflow: hidden; border-radius: 8px;">
                            {% if room.Thumbnail %}
                                <img src="{{ asset(room.Thumbnail) }}" alt="Room Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                            {% else %}
                                <img src="{{ asset('images/default-room.jpg') }}" alt="Default Room Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                            {% endif %}
                        </div>

                        <div class="room-content">
                            <div class="room-title" style="margin-bottom: 10px;">
                                <h4 style="margin: 0; font-size: 18px; font-weight: bold;">{{ room.name }}</h4>
                                <p style="margin: 5px 0; color: #777;"><i class="fa fa-tag"></i> ${{ room.prix }} / Night</p>
                            </div>

                            <div class="room-services" style="font-size: 14px; margin-bottom: 10px;">
                                <p><i class="fa fa-bed" aria-hidden="true"></i> {{ room.bedNbr }} Bedrooms</p>
                            </div>

                            <p style="margin-bottom: 10px;">{{ room.description }}</p>

                            <div class="room-btns" style="margin-top: auto;">
                                <a href="{{ path('app_reservation_new', {'id': room.id}) }}" class="btn" style="padding: 8px 12px; border: none; border-radius: 5px; text-decoration: none; font-size: 14px; color: #fff; background-color: #ff5722;">RESERVE</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p class="text-center">No rooms available.</p>
            {% endfor %}
        </div>


    </div>
</section>
<!-- Room Ends -->


    <section class="services service-style-1 service-style-2">
        <div class="container-fluid">
            <div class="section-title">
                <h2 class="mar-0">Explore <span>Services</span></h2>
            </div>
            <br><br><br><br>
            <div class="service-outer">
                <div class="row">
                    {% for service in services %}
                        <div class="col-lg-3 col-md-6" style="margin-bottom: 50px">
                            <div class="service-item" style="width: 400px; height: 300px; position: relative;">
                                <div class="service-image" style="position: absolute; inset: 0;">
                                    <img
                                            src="{{ asset(service.Thumbnail) }}"
                                            alt="Image"
                                            style="width: 100%; height: 100%; object-fit: cover;"
                                    />
                                </div>
                                <div class="service-content" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);">
                                    <h4 class="mar-0">
                                        <a href="service-detail.html" class="white" style="text-decoration: none;">{{ service.nom }}</a>
                                    </h4>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

<!-- events starts -->
<section class="events pad-bottom-70">
    <div >
        <div class="section-title">
            <h2>Upcoming Events of <span>Hotux</span></h2>
            <p class="mar-bottom-30">
                Discover an array of exciting events at our hotel, from live music nights and culinary tastings to wellness workshops and family-friendly activities. There's always something happening to make your stay unforgettable!
            </p>
        </div>
        <div class="list-content" style="padding: 10px;">
            <div class="row" style="gap: 20px; margin: 0;">
                {% for event in events|slice(0, 3) %}
                    <div class="col-lg-4" style="display: flex; height: 650px">
                        <div class="room-item" style="border: 1px solid #ddd; border-radius: 8px; background-color: #fff; text-align: center; display: flex; flex-direction: column; margin: 15px 15px 20px; min-height: 500px;">
                            <div class="room-image" style="flex-shrink: 0; position: relative; height: 300px; overflow: hidden; border-radius: 8px;">
                                {% if event.Thumbnail %}
                                    <img src="{{ asset(event.Thumbnail) }}" alt="Event Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                                {% else %}
                                    <img src="{{ asset('images/default-event.jpg') }}" alt="Default Event Thumbnail" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
                                {% endif %}
                            </div>

                            <div class="room-content" style="flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; padding: 10px;">
                                <div class="room-title" style="margin-bottom: 10px;">
                                    <h4 style="margin: 0; font-size: 18px; font-weight: bold;">{{ event.name }}</h4>
                                    <p style="margin: 5px 0; color: #777;"><i class="fa fa-tag"></i> ${{ event.prix }}</p>
                                </div>

                                <div class="room-services" style="font-size: 14px; margin-bottom: 10px;">
                                    <p><i class="fa fa-calendar" aria-hidden="true"></i> {{ event.date|date('Y-m-d') }}</p>
                                </div>

                                <p style="margin-bottom: 5px; flex-grow: 1;">{{ event.description }}</p>

                                <div class="room-btns" style="margin-bottom: 10px;">
                                    <a href="{{ path('app_detail_event', {'id': event.id}) }}" class="btn" style="padding: 8px 12px; border: none; border-radius: 5px; text-decoration: none; font-size: 14px; color: #fff; background-color: #ff5722;">Learn More</a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">No Events available.</p>
                {% endfor %}
            </div>


        </div>
    </div>
</section>
<!-- Events Ends -->



{% endblock %}